BOT_TOKEN=

# Telegram MTProto credentials for Pyrogram
# Keep the API hash secret. Get these from Telegram's API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

DOWNLOAD_DIR=./downloads
TEMP_DIR=./tmp

# Pyrogram/Telegram supports bot uploads up to 2 GB.
MAX_TELEGRAM_FILE_SIZE=2147483648
# Keep disabled for reliable live Telegram progress; set true only if external progress is not required.
ARIA2_ENABLED=false
ARIA2_CONNECTIONS=16
ARIA2_SPLIT=16
ARIA2_MAX_CONCURRENT=2
MEDIA_SESSION_TTL_SECONDS=3600
