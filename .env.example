BOT_TOKEN=

# Telegram Local Bot API Server
# Use http://localhost:8081 for a single-host setup.
# In Docker Compose, use the local API service name, e.g. http://telegram-bot-api:8081.
TELEGRAM_API_BASE=http://localhost:8081
TELEGRAM_API_IS_LOCAL=true

DOWNLOAD_DIR=./downloads
TEMP_DIR=./tmp

# Telegram Local Bot API Server supports uploads up to 2000 MB.
MAX_TELEGRAM_FILE_SIZE=2147483648
ARIA2_CONNECTIONS=16
ARIA2_SPLIT=16
ARIA2_MAX_CONCURRENT=2
MEDIA_SESSION_TTL_SECONDS=3600
